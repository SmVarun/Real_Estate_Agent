      "boundElements": null,
      "updated": 1786853939259,
      "link": null,
      "locked": false,
      "text": "core modules : \n\n\nAI Sales CRM\n│\n├── Authentication\n├── CRM\n│   ├── Companies\n│   ├── Salespersons\n│   ├── Leads\n│   └── Assignments\n│\n├── Knowledge Base\n│   ├── Documents\n│   ├── PDF Processing\n│   └── Metadata\n│\n├── RAG\n│   ├── Chunking\n│   ├── Embeddings\n│   ├── ChromaDB\n│   ├── Retrieval\n│   └── LLM\n│\n├── Chat\n│   ├── Conversations\n│   ├── Messages\n│   └── Sources\n│\n└── AI → CRM\n    ├── Intent\n    ├── Interest\n    ├── Lead Creation\n    └── Lead Update",
      "fontSize": 12.468131753537824,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "core modules : \n\n\nAI Sales CRM\n│\n├── Authentication\n├── CRM\n│   ├── Companies\n│   ├── Salespersons\n│   ├── Leads\n│   └── Assignments\n│\n├── Knowledge Base\n│   ├── Documents\n│   ├── PDF Processing\n│   └── Metadata\n│\n├── RAG\n│   ├── Chunking\n│   ├── Embeddings\n│   ├── ChromaDB\n│   ├── Retrieval\n│   └── LLM\n│\n├── Chat\n│   ├── Conversations\n│   ├── Messages\n│   └── Sources\n│\n└── AI → CRM\n    ├── Intent\n    ├── Interest\n    ├── Lead Creation\n    └── Lead Update",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8CJDbgmeDAJzmofQxThjf",
      "type": "text",
      "x": 349.8381666234616,
      "y": 5020.467692746796,
      "width": 310.13666985236097,
      "height": 499.934704275468,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b08",
      "roundness": null,
      "seed": 654321442,
      "version": 95,
      "versionNonce": 877292926,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786854004045,
      "link": null,
      "locked": false,
      "text": "architectural flow : \n\n                    React\n                      │\n              REST / Socket.IO\n                      │\n                      ▼\n             Node.js + Express\n                      │\n          ┌───────────┴───────────┐\n          │                       │\n          ▼                       ▼\n   Primary Database          RAG Service\n          │                       │\n          │                       ▼\n          │                    LangChain\n          │                       │\n          │                       ▼\n          │                    ChromaDB\n          │                       │\n          │                       ▼\n          │                 HF Embeddings\n          │                       │\n          │                       ▼\n          │                       LLM\n          │\n          ▼\n    CRM Business Data",
      "fontSize": 14.2838486935848,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "architectural flow : \n\n                    React\n                      │\n              REST / Socket.IO\n                      │\n                      ▼\n             Node.js + Express\n                      │\n          ┌───────────┴───────────┐\n          │                       │\n          ▼                       ▼\n   Primary Database          RAG Service\n          │                       │\n          │                       ▼\n          │                    LangChain\n          │                       │\n          │                       ▼\n          │                    ChromaDB\n          │                       │\n          │                       ▼\n          │                 HF Embeddings\n          │                       │\n          │                       ▼\n          │                       LLM\n          │\n          ▼\n    CRM Business Data",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "h-YEVe16c-9-l6pmyw1xh",
      "type": "text",
      "x": 854.7647009511398,
      "y": 4995.221347859264,
      "width": 134.88064194546004,
      "height": 581.8009902165077,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b09",
