      "seed": 992859298,
      "version": 124,
      "versionNonce": 989652734,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786854067982,
      "link": null,
      "locked": false,
      "text": "Database Design : \n\nusers\n  │\n  ├── authentication\n  ├── roles\n  └── sessions\n\ncompanies\n  │\n  ├── users\n  ├── salespersons\n  ├── leads\n  └── documents\n\nsalespersons\n  │\n  └── assigned leads\n\nleads\n  │\n  ├── salesperson\n  ├── company\n  └── conversations\n\ndocuments\n  │\n  └── company\n\nconversations\n  │\n  └── messages\n\nmessages\n  │\n  └── conversation",
      "fontSize": 12.928910893700177,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Database Design : \n\nusers\n  │\n  ├── authentication\n  ├── roles\n  └── sessions\n\ncompanies\n  │\n  ├── users\n  ├── salespersons\n  ├── leads\n  └── documents\n\nsalespersons\n  │\n  └── assigned leads\n\nleads\n  │\n  ├── salesperson\n  ├── company\n  └── conversations\n\ndocuments\n  │\n  └── company\n\nconversations\n  │\n  └── messages\n\nmessages\n  │\n  └── conversation",
      "autoResize": true,
      "lineHeight": 1.25
    },
