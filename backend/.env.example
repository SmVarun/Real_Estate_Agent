# Every variable in this file except NODE_ENV is validated on boot by
# src/config/config.js — a missing one throws before the server starts.

PORT=3000

# Drives the `secure` flag on the auth cookies. Leave as `development`
# locally so cookies still work over plain http; set to `production` in
# any deployed environment, which requires https.
NODE_ENV=development

MONGODB_URL=

# Must be two DIFFERENT values. Distinct secrets are what stop a refresh
# token from being accepted as an access token.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Also used as the auth cookies' maxAge, so the cookie and the token
# inside it always expire together. Format: <number><s|m|h|d>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Gmail address + app password used by nodemailer for password-reset mail.
SENDER-EMAIL=
APP-PASSWORD=

# The frontend's EXACT origin (scheme + host + port). CORS runs with
# credentials: true, which makes a wildcard origin invalid — a mismatch
# here surfaces as a CORS error, not a 401. Also the base for the
# password-reset link.
FRONTEND_URL=http://localhost:5173

# S3 bucket backing the document upload API. The IAM principal needs
# s3:PutObject and s3:DeleteObject on <bucket>/documents/*.
AWS_S3_BUCKET_NAME=
AWS_REGION=
AWS_BUCKET_ACCESS_KEY=
AWS_BUCKET_SECRET_KEY=

# Hugging Face token for embedding generation. Create one at
# https://huggingface.co/settings/tokens with the
# "Make calls to Inference Providers" permission enabled.
HF_API_KEY=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_PROVIDER=hf-inference

# ChromaDB vector store. Start a local server with:
#   docker run -d --name chroma -p 8000:8000 -v chroma-data:/data chromadb/chroma
# Use the full URL (scheme included) — src/config/chroma.js splits it into
# the host/port/ssl options chromadb v3 expects.
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=crm_documents
